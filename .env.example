PORT=3000
# Fondasi T01 saja; aktivasi diblokir sampai seluruh jalur terisolasi.
MULTITENANT_ENABLED=0
ALLOW_AUTO_MIGRATE=0
MIGRATION_BACKUP_KEEP=5
DATA_DIR=./data
HOST=127.0.0.1
TRUST_PROXY=0
SECURE_COOKIE=0
LOGIN_MAX=5
LOGIN_LOCK_MIN=15
PASS_MIN=12
ADMIN_USER=admin
ADMIN_PASS=ganti-ini
SEND_DELAY_MIN=1200
SEND_DELAY_MAX=3500
RATE_PER_MINUTE=8
CHAT_COOLDOWN_MIN=10
DAILY_CAP=200
WARMUP_ENABLED=1
WARMUP_START=25
WARMUP_STEP=15
BUSINESS_START=0
BUSINESS_END=0
SESSION_TTL_DAYS=7
BACKUP_DIR=./backups
BACKUP_KEEP=7
BACKUP_HOUR=3
BACKUP_MEDIA=0
RETENTION_DAYS=0
# Media dinonaktifkan sampai pengelola mengaktifkan signed URL dan memasang kunci acak.
MEDIA_SIGNED_URLS_ENABLED=0
MEDIA_SIGNING_KEY=
CALL_AUTO_REJECT=0
